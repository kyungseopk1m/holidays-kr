{
  "name": "@kyungseopk1m/holidays-kr",
  "version": "2.1.1",
  "description": "한국천문연구원 기반 대한민국 공휴일 데이터",
  "main": "dist/cjs/index.js",
  "module": "dist/mjs/index.js",
  "types": "dist/mjs/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mjs/index.d.ts",
        "default": "./dist/mjs/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "jest",
    "build": "rm -fr dist/* && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && ./fixup.sh",
    "attw": "attw --pack .",
    "publint": "publint --strict",
    "check": "npm run attw && npm run publint",
    "deploy": "npm run build && npm run check && npm publish --access=public"
  },
  "private": false,
  "keywords": [
    "공휴일",
    "한국",
    "대한민국",
    "Korean",
    "Holidays",
    "Korea Holidays"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyungseopk1m/holidays-kr.git"
  },
  "bugs": {
    "url": "https://github.com/kyungseopk1m/holidays-kr/issues",
    "email": "kks0919@kakao.com"
  },
  "homepage": "https://github.com/kyungseopk1m/holidays-kr",
  "author": "Kyungseop Kim <kks0919@kakao.com> (https://github.com/kyungseopk1m)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "publint": "^0.3.12",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "files": [
    "dist"
  ]
}
